{
  "name": "sieve-NG",
  "description": "__MSG_extensionDescription__",
  "version": "0.6.2",
  "icons": {
    "64": "libs/icons/sieve-ng.svg"
  },
  "background": {
    "page": "background.html"
  },
  "manifest_version": 2,
  "default_locale": "en_US",
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve-ng@hightext.de",
      "strict_min_version": "128.0",
      "strict_max_version": "152.*"
    }
  },
  "permissions": [
    "accountsRead",
    "menus",
    "tabs",
    "storage"
  ],
  "experiment_apis": {
    "tcpSocket": {
      "schema": "api/schemas/tcp_socket.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "api/parent/ext-tcp-socket.js",
        "paths": [["tcpSocket"]]
      }
    },
    "SieveAccountsApi": {
      "schema": "api/sieve/SieveAccountsApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveAccountsApi.js",
        "paths": [
          [
            "sieve",
            "accounts"
          ]
        ]
      }
    }
  }
}